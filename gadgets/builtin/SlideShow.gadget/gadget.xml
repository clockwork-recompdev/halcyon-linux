<?xml version="1.0" encoding="utf-8"?>
<gadget>
  <name>Slide Show</name>
  <version>1.0</version>
  <author name="Halcyon Linux"/>
  <copyright>Halcyon Linux</copyright>
  <description>A rotating slide show of the pictures in a folder of your choice.</description>
